<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vencida</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #000; /* schwarz */
      color: #fff; /* weiß */
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      text-align: center;
    }

    header {
      padding: 50px 20px 20px 20px;
    }

    header h1 {
      font-size: 4em;
      margin: 0;
    }

    nav {
      margin-top: 40px;
    }

    nav a {
      display: inline-block;
      margin: 0 15px;
      padding: 10px 20px;
      color: #fff;
      text-decoration: none;
      font-size: 1.2em;
      border: 2px solid #fff;
      border-radius: 5px;
      transition: all 0.3s ease;
    }

    nav a:hover {
      background-color: #fff;
      color: #000;
      cursor: pointer;
    }

    /* Optional: damit Footer unten bleibt */
    footer {
      margin-top: auto;
      padding: 20px;
      font-size: 0.9em;
    }
  </style>
</head>
<body>

  <header>
    <h1>Vencida</h1>
  </header>

  <nav>
    <a href="#about">About Us</a>
    <a href="#shop">Shop Now</a>
    <a href="#contact">Kontakt</a>
  </nav>

  <footer>
    &copy; 2026 Vencida
  </footer>

</body>
</html>
